{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译当前文件 (MSVC)",
      "type": "process",
      "command": "${workspaceFolder}\\build.bat",
      "args": ["${file}"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$msCompile"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "运行当前文件",
      "type": "process",
      "command": "${workspaceFolder}\\build\\${fileBasenameNoExtension}.exe",
      "dependsOn": "编译当前文件 (MSVC)",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
    {
      "label": "清理编译产物",
      "type": "process",
      "command": "${workspaceFolder}\\clean.bat",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
